# VARUNA Environment Configuration
# ==========================================

# Copernicus Data Space Ecosystem (CDSE)
# Register at https://dataspace.copernicus.eu
CDSE_CLIENT_ID=your_client_id_here
CDSE_CLIENT_SECRET=your_client_secret_here
# Alternatively for direct OData basic/token auth:
CDSE_USERNAME=your_copernicus_email@example.com
CDSE_PASSWORD=your_copernicus_password

# CDSE API Endpoints
CDSE_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# Local storage and cache paths (never commit large raw rasters)
VARUNA_DATA_DIR=./data
VARUNA_CACHE_DIR=./cache

# Server settings
VARUNA_HOST=0.0.0.0
VARUNA_PORT=8000
VARUNA_LOG_LEVEL=INFO

# OpenStreetMap Overpass API (historical pre-event querying)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ESA SNAP Graph Processing Tool (GPT) executable
# SNAP_GPT_PATH=/path/to/esa-snap/bin/gpt
# DEM_SOURCE=Copernicus 30m Global DEM
